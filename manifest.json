{
  "manifest_version": 3,
  "name": "TimeLens",
  "version": "1.4.1",
  "description": "Local-only browser time tracker. Live page time, drift detection and categories. Your data never leaves this PC.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/i16.png", "48": "icons/i48.png", "128": "icons/i128.png" },
  "action": { "default_popup": "popup.html", "default_title": "TimeLens" },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["tabs", "storage", "idle", "sidePanel", "alarms", "favicon"]
}
